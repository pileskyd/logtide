{
  "name": "logtide",
  "version": "1.3.2",
  "private": true,
  "description": "LogTide - Self-hosted log management platform",
  "author": "LogTide Team",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "bun run --filter \"./packages/**\" dev",
    "dev:backend": "bun run --filter \"@logtide/backend\" dev",
    "dev:frontend": "bun run --filter \"@logtide/frontend\" dev",
    "dev:worker": "bun run --filter \"@logtide/backend\" dev:worker",
    "dev:all": "concurrently -n fe,be,wk -c blue,green,yellow \"bun run dev:frontend\" \"bun run dev:backend\" \"bun run dev:worker\"",
    "infra:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.dev.yml down",
    "build": "bun run --filter \"./packages/**\" build",
    "build:shared": "bun run --filter \"@logtide/shared\" build",
    "test": "bun run --filter \"./packages/**\" test",
    "test:e2e": "bun run --filter \"@logtide/frontend\" test:e2e",
    "test:e2e:up": "docker compose -f docker-compose.test.yml up -d --build",
    "test:e2e:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e:run": "bun run test:e2e:up && bun run test:e2e && bun run test:e2e:down",
    "test:e2e:headed": "bun run --filter \"@logtide/frontend\" test:e2e:headed",
    "test:e2e:debug": "bun run --filter \"@logtide/frontend\" test:e2e:debug",
    "typecheck": "bun run --filter \"./packages/**\" typecheck",
    "clean": "bun run --filter \"./packages/**\" clean"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": ">=0.25.0 <0.26.0",
    "shell-quote": ">=1.9.0",
    "form-data": ">=4.0.6",
    "vite": ">=6.4.3",
    "@opentelemetry/core": ">=2.8.0",
    "cookie": ">=0.7.0",
    "express": ">=5.2.0",
    "qs": ">=6.15.2",
    "devalue": ">=5.8.1",
    "picomatch": ">=4.0.4",
    "brace-expansion": ">=5.0.9",
    "fast-xml-parser": ">=5.7.0",
    "fast-uri": ">=3.1.5 <4",
    "find-my-way": ">=9.7.0",
    "js-yaml": ">=4.3.0 <5",
    "postcss": ">=8.5.18",
    "minimatch": ">=10.2.3",
    "ajv": ">=8.18.0",
    "rollup": ">=4.59.0",
    "svelte": ">=5.55.7",
    "@sveltejs/kit": ">=2.70.2",
    "protobufjs": ">=7.6.5 <8",
    "@protobufjs/utf8": ">=1.1.1",
    "kysely": ">=0.28.17 <0.29",
    "ws": ">=8.20.1",
    "uuid": ">=14.0.0",
    "undici": ">=7.29.0 <8",
    "@logtide/types": "0.7.0",
    "@logtide/browser": "0.7.0",
    "@logtide/core": "0.7.0"
  },
  "packageManager": "bun@1.4.0"
}
